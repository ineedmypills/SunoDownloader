# Maintainer: pilldev <pilldev@users.noreply.github.com>
pkgname=suno-tui
pkgver=0.1.0
pkgrel=1
pkgdesc="A powerful, feature-rich TUI and CLI for browsing and downloading Suno.ai tracks"
arch=('x86_64' 'aarch64')
url="https://github.com/ineedmypills/SunoDownloader"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=(
    'mpv: in-TUI audio preview and live streaming playback'
    'ffmpeg: 320 kbps MP3 conversion and stream transcoding'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7b7d991f61e211a69127e498fd10e0304a2bf545056c45c4721730672809fef4')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-features
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/suno-tui" "$pkgdir/usr/bin/suno-tui"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
